# Local development defaults. Copy to .env: cp .env.example .env
# Generate a real key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database. Unset = SQLite (db.sqlite3). Local Postgres (Docker):
# DATABASE_URL=postgresql://django:django@localhost:5432/django_api
# Neon (production; set in Render, never commit it). Use the direct endpoint, not -pooler:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Seconds to keep a DB connection open (default 60). A pooled endpoint needs 0, plus
# DISABLE_SERVER_SIDE_CURSORS = True in settings.DATABASES['default']:
# CONN_MAX_AGE=60
# Postgres only: seconds to wait for a new connection before failing (default 10). Must stay
# under gunicorn's 30 s worker timeout; 0 means psycopg's 130 s default. A connect_timeout in
# DATABASE_URL takes precedence:
# DB_CONNECT_TIMEOUT=10

# Frontend origins allowed to call the API cross-origin: scheme + host, no trailing slash,
# comma-separated with no spaces (a space becomes part of the origin and never matches).
# Production: https://<frontend>.<account>.workers.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origins allowed to send CSRF-protected forms (admin login). Production: https://<backend>.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# HSTS max-age in seconds, applied only when DEBUG=False (default 3600). Raise once HTTPS is confirmed.
# SECURE_HSTS_SECONDS=3600
# HTTP->HTTPS redirect when DEBUG=False (default True). Set False to run tests/CI with DEBUG=False.
# SECURE_SSL_REDIRECT=True

# Demo login account, created by `create_demo_user` and `reset_demo` (both fail without a password)
# Pick your own password: it is left unset so a copied file never seeds Neon with a
# guessable one (OPS-03 runs reset_demo locally)
DEMO_USERNAME=demo
# DEMO_PASSWORD=
# Login attempts allowed per client IP on POST /api/auth/token/ (default 20/min)
# LOGIN_THROTTLE_RATE=20/min
# Trusted proxies in front of the app; throttles use the client IP they forward (default 0 =
# REMOTE_ADDR). Render: set 1 once verified. Never higher than the real hop count
# NUM_PROXIES=0
